{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["_id", "bus_id", "capacity", "effective_from", "changed_by", "created_at"],
    "additionalProperties": true,
    "properties": {
      "_id": {
        "bsonType": "string",
        "pattern": "^BCH-BUS-[0-9]{6}-[0-9]{8}$",
        "description": "Bus capacity history ID. Format: BCH-BUS-000001-20261022"
      },
      "bus_id": {
        "bsonType": "string",
        "pattern": "^BUS-[0-9]{6}$",
        "description": "Reference to buses._id"
      },
      "capacity": {
        "bsonType": "int",
        "minimum": 1,
        "maximum": 100,
        "description": "Student passenger capacity as of effective_from"
      },
      "is_accessible": {
        "bsonType": "bool",
        "description": "Accessibility status as of effective_from"
      },
      "reason": {
        "bsonType": "string",
        "maxLength": 500,
        "description": "Human-readable reason for the capacity change"
      },
      "effective_from": {
        "bsonType": "date",
        "description": "Date from which this capacity record applies"
      },
      "effective_to": {
        "bsonType": ["date", "null"],
        "description": "Date on which this capacity record was superseded; null = current"
      },
      "changed_by": {
        "bsonType": "string",
        "description": "Actor who recorded this change"
      },
      "created_at": { "bsonType": "date" }
    }
  }
}
