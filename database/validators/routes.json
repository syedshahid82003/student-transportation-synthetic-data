{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["_id", "bus_id", "driver_id", "direction", "status", "pickup_window_start", "pickup_window_end", "effective_from", "created_at"],
    "additionalProperties": true,
    "properties": {
      "_id": {
        "bsonType": "string",
        "pattern": "^ROUTE-[0-9]{4}-[0-9]{6}$",
        "description": "Route business ID. Format: ROUTE-2026-000001"
      },
      "name": { "bsonType": "string", "minLength": 1, "maxLength": 150 },
      "bus_id": {
        "bsonType": "string",
        "pattern": "^BUS-[0-9]{6}$",
        "description": "Reference to buses._id"
      },
      "driver_id": {
        "bsonType": "string",
        "pattern": "^DRV-[0-9]{6}$",
        "description": "Reference to drivers._id"
      },
      "direction": {
        "bsonType": "string",
        "enum": ["am", "pm", "midday"],
        "description": "am = morning pickup, pm = afternoon dropoff, midday = special"
      },
      "status": {
        "bsonType": "string",
        "enum": ["active", "inactive", "cancelled", "completed"]
      },
      "pickup_window_start": {
        "bsonType": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
        "description": "HH:MM local time — earliest pickup time"
      },
      "pickup_window_end": {
        "bsonType": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
        "description": "HH:MM local time — latest pickup time"
      },
      "academic_year": {
        "bsonType": "int",
        "minimum": 2000,
        "maximum": 2100
      },
      "effective_from": { "bsonType": "date" },
      "effective_to":   { "bsonType": ["date", "null"] },
      "notes": { "bsonType": "string", "maxLength": 500 },
      "created_at": { "bsonType": "date" },
      "updated_at": { "bsonType": "date" }
    }
  }
}
